# Copy to .env.local; obtain authorized values privately. Never commit .env.local.
# Set true only for the isolated, login-free showcase. False restores normal login.
M360_SHOWCASE_ENABLED=false
# Optional hosted preview only. Use a CRM account assigned only to Lakhotia.
# Defaults to viewer. Set sales_operator only for a trusted recipient.
# Set expiration as an ISO timestamp and store only the SHA-256 of the URL pass.
M360_CLIENT_PREVIEW_PASS_SHA256=
M360_CLIENT_PREVIEW_EXPIRES_AT=
M360_CLIENT_PREVIEW_ROLE=
M360_CLIENT_PREVIEW_USERNAME=
M360_CLIENT_PREVIEW_PASSWORD=
# The existing CRM gateway requires the SAME shared key as the authorized hosted preview.
M360_AI_POST_SIGNING_SECRET=
M360_AI_TRIAL_SUPABASE_SERVICE_KEY=
M360_CONTROL_CENTER_ENABLED=true
M360_CONTROL_CENTER_MODEL=gpt-4.1-mini
M360_CRM_DEV_PUBLISHABLE_KEY=
M360_MAPS_SCRAPER_URL=
M360_MAPS_V4_THREE_WORKER_KEY=
M360_OPENAI_FFMPEG_WORKER_URL=
M360_OPENAI_IMAGE_MODEL=
M360_OPENAI_SPEND_APPROVED=
M360_OPENAI_TEXT_MODEL=
M360_REEL_WORKER_KEY=
M360_ROMIT_ORIGINAL_SCRAPER_PREVIEW_KEY=
M360_SOCIAL_AUTO_PROVISION=
M360_SOCIAL_DIRECTOR_KEY=
M360_SOCIAL_IMAGE_APPROVED=
M360_SOCIAL_OPERATOR_KEY=
M360_SOCIAL_PLAN_APPROVED=
M360_SOCIAL_WORKSPACE_MAP=
M360_WEBSITE_ENGINE_URL=
OPENAI_API_KEY=

# Marketing keyless mode and provider safety. Keep live/paid settings false or zero.
M360_KEYLESS_TEST_MODE=false
M360_MARKETING_DURABLE_ENABLED=false
M360_MARKETING_SUPABASE_URL=
# Local preview recovery only. The data/ directory is gitignored.
M360_MARKETING_LOCAL_STORE_PATH=data/marketing-state.json

# Brevo SMTP: use the SMTP login and SMTP key from Brevo, not the website password.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_CLIENT_NAME=matrix360.local
BREVO_SENDER_EMAIL=
BREVO_WEBHOOK_BEARER_TOKEN=
MARKETING_LIVE_SEND_ENABLED=false
MARKETING_ALLOWED_EMAILS=
MARKETING_MAX_LIVE_RECIPIENTS=1
M360_MARKETING_AI_ENABLED=false
MARKETING_PAID_SEND_ENABLED=false
MARKETING_ALLOWED_RECIPIENT_MODE=self_only
MARKETING_MAX_LIVE_MESSAGES=0
MARKETING_ALLOW_PAID_ADS=false
MARKETING_PROVIDER_EMAIL=none
MARKETING_PROVIDER_WHATSAPP=manual_click_to_chat
MARKETING_PROVIDER_META=none
MARKETING_PROVIDER_LINKEDIN=none
BREVO_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_API_VERSION=

# Document upload and engine gateway
MATRIX360_ENGINE_BASE_URL=
MATRIX360_ENGINE_SERVICE_AUTH_SECRET=
M360_LEADS_TASK_API_URL=
M360_CONTENT_TASK_API_URL=
M360_CRM_CSV_IMPORT_URL=
MATRIX360_CRM_API_URL=
MATRIX360_DOCUMENT_MAX_UPLOAD_BYTES=26214400
